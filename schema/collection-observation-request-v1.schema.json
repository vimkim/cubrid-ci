{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubrid.org/schemas/cubrid-ci/collection-observation-request-v1.schema.json",
  "title": "cubrid-ci collection observation request v1",
  "type": "object",
  "required": [
    "schema_version",
    "observation_id",
    "repository",
    "pr",
    "commit",
    "started_at",
    "requested_suites",
    "fetch_concurrency",
    "binary_budget"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observation_id": { "type": "string", "minLength": 1 },
    "repository": { "const": "CUBRID/cubrid" },
    "pr": {
      "type": "object",
      "required": ["number", "url", "title", "head_sha"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      },
      "additionalProperties": false
    },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "requested_suites": {
      "type": "array",
      "items": { "enum": ["test_medium", "test_sql", "test_shell"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "fetch_concurrency": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": { "type": "integer", "minimum": 1 },
        "source": { "enum": ["command_line", "environment", "config_file", "default"] }
      },
      "additionalProperties": false
    },
    "binary_budget": {
      "type": "object",
      "required": ["include", "per_file_bytes", "total_bytes"],
      "properties": {
        "include": { "type": "boolean" },
        "per_file_bytes": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
