{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cubrid.org/schemas/cubrid-ci/raw-evidence-index-v2.schema.json",
  "title": "CUBRID CI raw evidence index v2",
  "type": "object",
  "required": ["schema_version", "run_id", "attempt", "suite", "files"],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "suite": { "enum": ["test_medium", "test_sql", "test_shell"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
